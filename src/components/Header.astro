---
import { getLang, homePath, routes, translatePath, ui } from '../i18n';

const lang = getLang(Astro.url);
const t = ui[lang];
const navLinks = t.nav;
const otherLang = lang === 'es' ? 'en' : 'es';
const switchHref = translatePath(Astro.url, otherLang);
const isActive = (href: string) =>
  href === homePath[lang] ? currentPath === href : currentPath.startsWith(href);

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 inset-x-0 z-50 bg-black border-b border-white/10">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href={homePath[lang]} class="flex items-center gap-2 flex-shrink-0" aria-label={t.homeLabel}>
      <img src="/img/logo-upsomedia.png" alt="Upsomedia" width="894" height="106" class="h-5 w-auto" />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-1" role="list">
      {navLinks.map(({ href, label }) => {
        const active = isActive(href);
        return (
          <li>
            <a
              href={href}
              class:list={[
                'px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-150',
                active
                  ? 'text-black bg-white'
                  : 'text-gray-300 hover:text-white hover:bg-white/10',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- LinkedIn + CTA desktop -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="https://www.linkedin.com/company/upsomedia-com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Upsomedia en LinkedIn"
        class="opacity-90 hover:opacity-100 transition-opacity"
      >
        <img src="/img/linkedin.png" alt="" width="28" height="28" class="w-7 h-7" />
      </a>
      <a
        href={switchHref}
        hreflang={otherLang}
        lang={otherLang}
        aria-label={t.switchLabel}
        class="text-sm font-semibold uppercase text-gray-300 hover:text-white transition-colors"
      >
        {otherLang}
      </a>
      <a href={routes.contact[lang]} class="btn-rosa text-sm">
        {t.cta}
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      class="md:hidden p-2 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
      aria-label={t.openMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-white/10 bg-black">
    <ul class="px-4 py-3 space-y-1" role="list">
      {navLinks.map(({ href, label }) => {
        const active = isActive(href);
        return (
          <li>
            <a
              href={href}
              class:list={[
                'block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors',
                active
                  ? 'text-black bg-white'
                  : 'text-gray-300 hover:text-white hover:bg-white/10',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
      <li class="pt-2">
        <a href={switchHref} hreflang={otherLang} lang={otherLang} class="block px-4 py-2.5 rounded-lg text-sm font-medium text-gray-300 hover:text-white hover:bg-white/10 transition-colors">
          {t.switchLabel}
        </a>
      </li>
      <li class="pt-2">
        <a href={routes.contact[lang]} class="btn-rosa w-full text-center">{t.cta}</a>
      </li>
    </ul>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const iconOpen  = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });
</script>
