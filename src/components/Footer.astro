---
const year = new Date().getFullYear();

import { getLang, homePath, ui } from '../i18n';

const lang = getLang(Astro.url);
const t = ui[lang];
const navLinks = t.nav.filter(({ href }) => !href.includes('#'));
---

<footer class="bg-gray-950 text-gray-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Brand -->
      <div class="space-y-4">
        <a href={homePath[lang]} class="inline-block">
          <img src="/img/logo-upsomedia.png" alt="Upsomedia" width="894" height="106" loading="lazy" class="h-6 w-auto" />
        </a>
        <p class="text-sm leading-relaxed">
          {t.tagline}<br />
          #SiempreCreandoUpsomedia
        </p>
      </div>

      <!-- Nav -->
      <div>
        <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-widest mb-4">{t.sections}</h3>
        <ul class="space-y-2">
          {navLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm hover:text-white transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xs font-semibold text-gray-300 uppercase tracking-widest mb-4">{t.contact}</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-rosa" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Av. Raúl Labbe 12613 of 632,<br />Lo Barnechea, Santiago, Chile</span>
          </li>
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-rosa" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+56222487682" class="hover:text-white transition-colors">
              +56 2 2248 7682
            </a>
          </li>
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-rosa" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <a
              href="https://www.linkedin.com/company/upsomedia-com"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-600">
      <p>&copy; {year} Upsomedia. {t.rights}</p>
      <p>{t.madeIn[0]} <span class="text-rosa">♥</span> {t.madeIn[1]}</p>
    </div>
  </div>
</footer>
