---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import { routes, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  es: {
    title: 'Contacto',
    description: 'Contáctanos en Upsomedia. Estamos en Av. Raúl Labbe 12613, Lo Barnechea, Santiago, Chile. Teléfono: +56 2 2248 7682.',
    kicker: 'Estamos aquí',
    lead: '¿Tienes un proyecto, una consulta o simplemente quieres saber más? Escríbenos, estaremos encantados de ayudarte.',
    infoTitle: 'Información de contacto',
    address: 'Dirección',
    phone: 'Teléfono',
    formTitle: 'Envíanos un mensaje',
    formIntro: 'Te responderemos a la brevedad.',
    subject: 'Nuevo mensaje desde upsomedia.com',
    name: 'Nombre',
    namePlaceholder: 'Tu nombre',
    emailPlaceholder: 'tu@email.com',
    company: 'Empresa / Organización',
    companyPlaceholder: 'Tu empresa (opcional)',
    topic: 'Asunto',
    topicPlaceholder: 'Selecciona un tema',
    topics: [
      { value: 'produccion-video',     label: 'Producción de video' },
      { value: 'contenido-multimedia', label: 'Contenido multimedia' },
      { value: 'gestion-canales',      label: 'Gestión de canales' },
      { value: 'branded-content',      label: 'Branded content' },
      { value: 'otro',                 label: 'Otro' },
    ],
    message: 'Mensaje',
    messagePlaceholder: 'Cuéntanos sobre tu proyecto o consulta...',
    success: 'Mensaje enviado con éxito. Te responderemos pronto.',
    error: 'Ocurrió un error al enviar el mensaje. Por favor intenta nuevamente.',
    send: 'Enviar mensaje',
    sending: 'Enviando…',
  },
  en: {
    title: 'Contact us',
    description: 'Get in touch with Upsomedia. We are at Av. Raúl Labbe 12613, Lo Barnechea, Santiago, Chile. Phone: +56 2 2248 7682.',
    kicker: "We're here",
    lead: "Have a project, a question or just want to know more? Write to us, we'll be happy to help.",
    infoTitle: 'Contact information',
    address: 'Address',
    phone: 'Phone',
    formTitle: 'Send us a message',
    formIntro: "We'll get back to you shortly.",
    subject: 'New message from upsomedia.com (EN)',
    name: 'Name',
    namePlaceholder: 'Your name',
    emailPlaceholder: 'you@email.com',
    company: 'Company / Organization',
    companyPlaceholder: 'Your company (optional)',
    topic: 'Subject',
    topicPlaceholder: 'Choose a topic',
    topics: [
      { value: 'produccion-video',     label: 'Video production' },
      { value: 'contenido-multimedia', label: 'Multimedia content' },
      { value: 'gestion-canales',      label: 'Channel management' },
      { value: 'branded-content',      label: 'Branded content' },
      { value: 'otro',                 label: 'Other' },
    ],
    message: 'Message',
    messagePlaceholder: 'Tell us about your project or question...',
    success: "Message sent successfully. We'll get back to you soon.",
    error: 'Something went wrong while sending your message. Please try again.',
    send: 'Send message',
    sending: 'Sending…',
  },
}[lang];

const redirectURL = new URL(`${routes.contact[lang]}?enviado=1`, Astro.site).href;
const field = 'w-full border-2 border-gray-950 bg-white px-4 py-2.5 text-sm text-gray-950 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-rosa focus:border-rosa transition';
const iconBox = 'w-10 h-10 bg-rosa text-gray-950 flex items-center justify-center flex-shrink-0';
---

<Layout title={content.title} description={content.description} lang={lang} alternates={routes.contact}>

  <PageHero kicker={content.kicker} title={content.title} lead={content.lead} />

  <section class="bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-5 gap-12 lg:gap-16">

      <!-- Info -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl md:text-3xl font-extrabold uppercase tracking-tight text-gray-950 mb-8">{content.infoTitle}</h2>
        <ul class="space-y-6" role="list">
          <li class="flex gap-4">
            <div class={iconBox}>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold uppercase text-gray-950 mb-1">{content.address}</p>
              <p class="text-sm text-gray-700">
                Av. Raúl Labbe 12613 of 632<br />
                Lo Barnechea, Santiago, Chile
              </p>
            </div>
          </li>

          <li class="flex gap-4">
            <div class={iconBox}>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold uppercase text-gray-950 mb-1">{content.phone}</p>
              <a href="tel:+56222487682" class="text-sm text-gray-700 hover:text-rosa transition-colors">
                +56 2 2248 7682
              </a>
            </div>
          </li>

          <li class="flex gap-4">
            <div class={iconBox}>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold uppercase text-gray-950 mb-1">Email</p>
              <a href="mailto:contacto@upsomedia.com" class="text-sm text-gray-700 hover:text-rosa transition-colors">
                contacto@upsomedia.com
              </a>
            </div>
          </li>

          <li class="flex gap-4">
            <div class={iconBox}>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold uppercase text-gray-950 mb-1">LinkedIn</p>
              <a
                href="https://www.linkedin.com/company/upsomedia-com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-gray-700 hover:text-rosa transition-colors"
              >
                linkedin.com/company/upsomedia-com
              </a>
            </div>
          </li>
        </ul>
      </div>

      <!-- Form -->
      <div class="lg:col-span-3">
        <div class="bg-sol p-6 md:p-10">
          <h2 class="text-2xl md:text-3xl font-extrabold uppercase tracking-tight text-gray-950 mb-2">{content.formTitle}</h2>
          <p class="text-sm text-gray-950 mb-8">{content.formIntro}</p>

          <!--
            Web3Forms: servicio gratuito sin backend.
            Reemplaza el valor de "access_key" con tu clave de https://web3forms.com
          -->
          <form
            id="contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-5"
            novalidate
          >
            <input type="hidden" name="access_key" value="TU_ACCESS_KEY_AQUI" />
            <input type="hidden" name="subject" value={content.subject} />
            <input type="hidden" name="redirect" value={redirectURL} />
            <!-- Honeypot anti-spam -->
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-bold text-gray-950 mb-1.5">
                  {content.name} <span class="text-rosa">*</span>
                </label>
                <input type="text" id="name" name="name" required autocomplete="name" placeholder={content.namePlaceholder} class={field} />
              </div>
              <div>
                <label for="email" class="block text-sm font-bold text-gray-950 mb-1.5">
                  Email <span class="text-rosa">*</span>
                </label>
                <input type="email" id="email" name="email" required autocomplete="email" placeholder={content.emailPlaceholder} class={field} />
              </div>
            </div>

            <div>
              <label for="company" class="block text-sm font-bold text-gray-950 mb-1.5">{content.company}</label>
              <input type="text" id="company" name="company" autocomplete="organization" placeholder={content.companyPlaceholder} class={field} />
            </div>

            <div>
              <label for="subject_detail" class="block text-sm font-bold text-gray-950 mb-1.5">
                {content.topic} <span class="text-rosa">*</span>
              </label>
              <select id="subject_detail" name="subject_detail" required class={field}>
                <option value="" disabled selected>{content.topicPlaceholder}</option>
                {content.topics.map(({ value, label }) => <option value={value}>{label}</option>)}
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-bold text-gray-950 mb-1.5">
                {content.message} <span class="text-rosa">*</span>
              </label>
              <textarea id="message" name="message" required rows="5" placeholder={content.messagePlaceholder} class:list={[field, 'resize-none']}></textarea>
            </div>

            <!-- Success / error messages (shown via JS) -->
            <div id="form-success" class="hidden bg-white border-2 border-gray-950 p-4 text-sm font-semibold text-gray-950" role="alert">
              {content.success}
            </div>
            <div id="form-error" class="hidden bg-white border-2 border-rosa p-4 text-sm font-semibold text-gray-950" role="alert">
              {content.error}
            </div>

            <button type="submit" id="submit-btn" class="btn-rosa w-full py-3 text-base">
              <span id="btn-text">{content.send}</span>
              <span id="btn-loading" class="hidden">{content.sending}</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg   = document.getElementById('form-error');
  const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText    = document.getElementById('btn-text');
  const btnLoading = document.getElementById('btn-loading');

  // Show success banner if redirected back after submit
  if (window.location.search.includes('enviado=1')) {
    successMsg?.classList.remove('hidden');
    window.history.replaceState({}, '', window.location.pathname);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) submitBtn.disabled = true;
    btnText?.classList.add('hidden');
    btnLoading?.classList.remove('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      const data = new FormData(form);
      const res  = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      const json = await res.json();

      if (json.success) {
        successMsg?.classList.remove('hidden');
        form.reset();
      } else {
        errorMsg?.classList.remove('hidden');
      }
    } catch {
      errorMsg?.classList.remove('hidden');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      btnText?.classList.remove('hidden');
      btnLoading?.classList.add('hidden');
    }
  });
</script>
