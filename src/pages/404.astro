---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="La página que buscas no existe en Upsomedia.">
  <section class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-gray-50 py-20">
    <div class="text-center max-w-md px-4">
      <p class="text-8xl font-black text-brand-600 mb-4">404</p>
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Página no encontrada</h1>
      <p class="text-gray-500 mb-8">
        Esta página no existe o fue movida. Vuelve al inicio para seguir explorando.
      </p>
      <a href="/" class="btn-primary">
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
