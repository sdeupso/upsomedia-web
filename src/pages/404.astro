---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="La página que buscas no existe en Upsomedia.">
  <section class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-[#111] text-white py-20">
    <div class="text-center max-w-md px-4">
      <p class="text-8xl font-extrabold text-rosa mb-4">404</p>
      <h1 class="text-3xl font-extrabold uppercase tracking-tight mb-4">Página no encontrada</h1>
      <p class="text-gray-300 mb-2">
        Esta página no existe o fue movida. Vuelve al inicio para seguir explorando.
      </p>
      <p class="text-gray-400 text-sm mb-8" lang="en">This page doesn't exist or has been moved.</p>
      <a href="/" class="btn-rosa sm:px-12">
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
