---
import Layout from '../layouts/Layout.astro';

const stats = [
  { value: '+120M',  label: 'Seguidores acumulados' },
  { value: '+8.000', label: 'Videos producidos al mes' },
  { value: '+50',    label: 'Canales activos' },
  { value: '+10',    label: 'Años de experiencia' },
];

const services = [
  {
    icon: 'video',
    title: 'Producción de Video',
    description: 'Más de 8.000 videos al mes para plataformas como YouTube, TikTok e Instagram.',
  },
  {
    icon: 'content',
    title: 'Creación de Contenido',
    description: 'Contenido multimedia original, relevante y transversal para distintas audiencias.',
  },
  {
    icon: 'channels',
    title: 'Gestión de Canales',
    description: 'Administración integral de canales sociales para maximizar alcance y engagement.',
  },
  {
    icon: 'writing',
    title: 'Redacción Editorial',
    description: 'Artículos y textos de calidad periodística adaptados a cada plataforma y formato.',
  },
];

const iconPaths: Record<string, string> = {
  video:    'M15 10l4.553-2.276A1 1 0 0121 8.723v6.554a1 1 0 01-1.447.894L15 14M4 6h8a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2z',
  content:  'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  channels: 'M13 10V3L4 14h7v7l9-11h-7z',
  writing:  'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
};
---

<Layout
  title="Upsomedia"
  description="Upsomedia: generación de contenido original, relevante y transversal. +120M seguidores. El medio de entretenimiento más curioso del mundo."
>

  <!-- Hero -->
  <section class="relative bg-gray-950 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand-900/40 via-gray-950 to-gray-950" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28 md:py-40">
      <div class="max-w-3xl">
        <p class="text-brand-400 text-sm font-semibold tracking-widest uppercase mb-6">
          #SiempreCreandoUpsomedia
        </p>
        <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-none mb-8">
          Siempre <br />
          <span class="text-brand-400">creando,</span><br />
          somos Upsomedia.
        </h1>
        <p class="text-lg md:text-xl text-gray-300 max-w-xl leading-relaxed mb-10">
          Generamos contenido original, relevante y transversal para millones de personas.
          El medio de entretenimiento más curioso del mundo.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/servicios" class="btn-primary text-base px-8 py-4">
            Conoce nuestros servicios
          </a>
          <a href="/nosotros" class="btn-secondary border-white/30 text-white hover:bg-white/10 text-base px-8 py-4">
            Quiénes somos
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-brand-600 text-white py-16" aria-label="Estadísticas">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center" role="list">
        {stats.map(({ value, label }) => (
          <li>
            <p class="text-4xl md:text-5xl font-black mb-1">{value}</p>
            <p class="text-brand-100 text-sm font-medium">{label}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- About teaser -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-brand-600 text-sm font-semibold tracking-widest uppercase mb-4">Quiénes somos</p>
          <h2 class="section-title mb-6">
            El medio de entretenimiento<br />
            <span class="text-brand-600">más curioso del mundo</span>
          </h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            En Upsomedia somos un equipo apasionado por contar historias que conectan con la gente.
            Producimos contenido original y de alta calidad en múltiples formatos y plataformas,
            alcanzando a millones de personas en todo el mundo hispanohablante.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            Desde Santiago de Chile, operamos una red de canales digitales con alcance global,
            generando más de 8.000 videos al mes y miles de artículos editoriales.
          </p>
          <a href="/nosotros" class="btn-primary">
            Conocer más
          </a>
        </div>
        <div class="bg-gray-50 rounded-2xl p-10 border border-gray-100">
          <blockquote class="text-2xl font-bold text-gray-800 leading-snug mb-6">
            "Contenido original, relevante y transversal para distintas audiencias."
          </blockquote>
          <p class="text-brand-600 font-semibold text-sm tracking-wide">— Equipo Upsomedia</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services preview -->
  <section class="py-24 bg-gray-50" id="servicios-preview">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-brand-600 text-sm font-semibold tracking-widest uppercase mb-4">Lo que hacemos</p>
        <h2 class="section-title">Nuestros servicios</h2>
        <p class="section-subtitle mx-auto">
          Creamos, producimos y distribuimos contenido que genera impacto real.
        </p>
      </div>

      <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
        {services.map(({ icon, title, description }) => (
          <li class="bg-white rounded-2xl p-8 border border-gray-100 hover:border-brand-200 hover:shadow-md transition-all duration-200 group">
            <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center mb-5 group-hover:bg-brand-600 group-hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconPaths[icon]} />
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2 text-lg">{title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
          </li>
        ))}
      </ul>

      <div class="text-center mt-12">
        <a href="/servicios" class="btn-primary">
          Ver todos los servicios
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-gray-950 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl md:text-5xl font-black mb-6 tracking-tight">
        No te quedes<br />con las ganas.
      </h2>
      <p class="text-gray-400 text-lg mb-10">
        ¿Tienes un proyecto en mente? Hablemos y veamos cómo podemos ayudarte.
      </p>
      <a href="/contacto" class="btn-primary text-base px-10 py-4">
        Contáctanos ahora
      </a>
    </div>
  </section>

</Layout>
