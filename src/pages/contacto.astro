---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto"
  description="Contáctanos en Upsomedia. Estamos en Av. Raúl Labbe 12613, Lo Barnechea, Santiago, Chile. Teléfono: +56 2 2248 7682."
>

  <!-- Hero -->
  <section class="bg-gray-950 text-white py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-brand-400 text-sm font-semibold tracking-widest uppercase mb-4">Estamos aquí</p>
        <h1 class="text-5xl md:text-6xl font-black tracking-tight mb-6">
          Contacto
        </h1>
        <p class="text-gray-400 text-xl leading-relaxed">
          ¿Tienes un proyecto, una consulta o simplemente quieres saber más?
          Escríbenos, estaremos encantados de ayudarte.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-16">

        <!-- Info -->
        <div class="lg:col-span-2 space-y-10">
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Información de contacto</h2>
            <ul class="space-y-6" role="list">
              <li class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900 mb-1">Dirección</p>
                  <p class="text-sm text-gray-500">
                    Av. Raúl Labbe 12613 of 632<br />
                    Lo Barnechea, Santiago, Chile
                  </p>
                </div>
              </li>

              <li class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900 mb-1">Teléfono</p>
                  <a href="tel:+56222487682" class="text-sm text-gray-500 hover:text-brand-600 transition-colors">
                    +56 2 2248 7682
                  </a>
                </div>
              </li>

              <li class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900 mb-1">Email</p>
                  <a href="mailto:contacto@upsomedia.com" class="text-sm text-gray-500 hover:text-brand-600 transition-colors">
                    contacto@upsomedia.com
                  </a>
                </div>
              </li>

              <li class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900 mb-1">LinkedIn</p>
                  <a
                    href="https://www.linkedin.com/company/upsomedia-com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-gray-500 hover:text-brand-600 transition-colors"
                  >
                    linkedin.com/company/upsomedia-com
                  </a>
                </div>
              </li>
            </ul>
          </div>
        </div>

        <!-- Form -->
        <div class="lg:col-span-3">
          <div class="bg-gray-50 rounded-2xl p-8 md:p-10 border border-gray-100">
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Envíanos un mensaje</h2>
            <p class="text-sm text-gray-500 mb-8">
              Te responderemos a la brevedad.
            </p>

            <!--
              Web3Forms: servicio gratuito sin backend.
              Reemplaza el valor de "access_key" con tu clave de https://web3forms.com
            -->
            <form
              id="contact-form"
              action="https://api.web3forms.com/submit"
              method="POST"
              class="space-y-5"
              novalidate
            >
              <input type="hidden" name="access_key" value="TU_ACCESS_KEY_AQUI" />
              <input type="hidden" name="subject" value="Nuevo mensaje desde upsomedia.com" />
              <input type="hidden" name="redirect" value="https://upsomedia.com/contacto?enviado=1" />
              <!-- Honeypot anti-spam -->
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">
                    Nombre <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    autocomplete="name"
                    placeholder="Tu nombre"
                    class="w-full rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">
                    Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    autocomplete="email"
                    placeholder="tu@email.com"
                    class="w-full rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
                  />
                </div>
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-gray-700 mb-1.5">
                  Empresa / Organización
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  autocomplete="organization"
                  placeholder="Tu empresa (opcional)"
                  class="w-full rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
                />
              </div>

              <div>
                <label for="subject_detail" class="block text-sm font-medium text-gray-700 mb-1.5">
                  Asunto <span class="text-red-500">*</span>
                </label>
                <select
                  id="subject_detail"
                  name="subject_detail"
                  required
                  class="w-full rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
                >
                  <option value="" disabled selected>Selecciona un tema</option>
                  <option value="produccion-video">Producción de video</option>
                  <option value="contenido-multimedia">Contenido multimedia</option>
                  <option value="gestion-canales">Gestión de canales</option>
                  <option value="branded-content">Branded content</option>
                  <option value="otro">Otro</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1.5">
                  Mensaje <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  placeholder="Cuéntanos sobre tu proyecto o consulta..."
                  class="w-full rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition resize-none"
                ></textarea>
              </div>

              <!-- Success / error messages (shown via JS) -->
              <div id="form-success" class="hidden rounded-lg bg-green-50 border border-green-200 p-4 text-sm text-green-700" role="alert">
                Mensaje enviado con éxito. Te responderemos pronto.
              </div>
              <div id="form-error" class="hidden rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-700" role="alert">
                Ocurrió un error al enviar el mensaje. Por favor intenta nuevamente.
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="btn-primary w-full py-3 text-base"
              >
                <span id="btn-text">Enviar mensaje</span>
                <span id="btn-loading" class="hidden">Enviando…</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg   = document.getElementById('form-error');
  const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText    = document.getElementById('btn-text');
  const btnLoading = document.getElementById('btn-loading');

  // Show success banner if redirected back after submit
  if (window.location.search.includes('enviado=1')) {
    successMsg?.classList.remove('hidden');
    window.history.replaceState({}, '', '/contacto');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) submitBtn.disabled = true;
    btnText?.classList.add('hidden');
    btnLoading?.classList.remove('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      const data = new FormData(form);
      const res  = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      const json = await res.json();

      if (json.success) {
        successMsg?.classList.remove('hidden');
        form.reset();
      } else {
        errorMsg?.classList.remove('hidden');
      }
    } catch {
      errorMsg?.classList.remove('hidden');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      btnText?.classList.remove('hidden');
      btnLoading?.classList.add('hidden');
    }
  });
</script>
